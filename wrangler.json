{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jerebu-my",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "jerebu-my"
    }
  ],
  "vars": {
    "DATA_MODE": "demo"
  },
  "send_metrics": false
}
