DATA_MODE=demo
# For private local live requests, set DATA_MODE=live and add your own key to .env.local.
# Registration: https://aqicn.org/data-platform/token/
# Never prefix this variable with NEXT_PUBLIC_. Public use has additional WAQI terms.
WAQI_API_TOKEN=
# Counts discovery, hydration and retries per snapshot; Cloudflare Free uses 45.
# WAQI_MAX_REQUESTS=45
